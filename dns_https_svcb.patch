+// =====================================================================
+// HTTPS SVCB 记录处理 - 集成 ECH 和 ALPN
+// =====================================================================
+
+#include "net/dns/host_resolver_manager.h"
+#include "net/base/features.h"
+#include "net/dns/public/dns_protocol.h"
+
+namespace net {
+
+// 从 HTTPS DNS 记录中提取连接参数
+//
+// HTTPS/SVCB 记录格式 (RFC 9460):
+//   example.com. 3600 IN HTTPS 1 . alpn="h3,h2" echconfig="..." ipv4hint="..."
+//
+// 参数说明:
+//   alpn:      支持的 ALPN 协议列表 (h3=HTTP/3, h2=HTTP/2)
+//   echconfig: ECH 公钥配置 (Base64 编码)
+//   ipv4hint:  IPv4 地址提示 (跳过 A 记录查询)
+//   ipv6hint:  IPv6 地址提示 (跳过 AAAA 记录查询)
+//   port:      非标准端口
+//
+// 返回解析后的连接信息
+struct HttpsSvcbResult {
+  std::vector<std::string> alpn;
+  std::string ech_config;
+  IPAddressList ipv4_hints;
+  IPAddressList ipv6_hints;
+  absl::optional<uint16_t> port;
+};
+
+// 解析 HTTPS 记录参数
+HttpsSvcbResult ParseHttpsRecordParams(
+    const std::vector<DnsProtocol::SvcParam>& params) {
+  HttpsSvcbResult result;
+
+  for (const auto& param : params) {
+    switch (param.key()) {
+      case DnsProtocol::kSvcParamAlpn:
+        // ALPN 协议列表: "h3,h2,h1"
+        // 解析为: ["h3", "h2", "h1"]
+        result.alpn = SplitString(
+            param.value(), ',', TRIM_WHITESPACE, SPLIT_WANT_NONEMPTY);
+        break;
+
+      case DnsProtocol::kSvcParamEchConfig:
+        // ECH 配置: Base64 编码的 ECHConfigList
+        result.ech_config = param.value();
+        break;
+
+      case DnsProtocol::kSvcParamIpv4Hint:
+        // IPv4 地址提示 (逗号分隔)
+        result.ipv4_hints = ParseIpv4Hints(param.value());
+        break;
+
+      case DnsProtocol::kSvcParamIpv6Hint:
+        // IPv6 地址提示 (逗号分隔)
+        result.ipv6_hints = ParseIpv6Hints(param.value());
+        break;
+
+      case DnsProtocol::kSvcParamPort:
+        // 非标准端口
+        result.port = ParsePort(param.value());
+        break;
+    }
+  }
+
+  return result;
+}
+
+// 将 HTTPS 记录结果应用到连接
+//
+// 在 HostResolverManager::Resolve() 中调用
+// 将 SVCB 参数传递给上层 (URLRequest, SSLClientSocket)
+void ApplyHttpsSvcbToRequest(ResolveContext* context,
+                              const HttpsSvcbResult& svcb_result,
+                              const NetworkAnonymizationKey& nik) {
+  if (!base::FeatureList::IsEnabled(features::kUseDnsHttpsSvcb))
+    return;
+
+  // 1. 提取 ECH 配置 -> 传递给 SSL 连接
+  if (!svcb_result.ech_config.empty()) {
+    context->SetEchConfig(nik, svcb_result.ech_config);
+  }
+
+  // 2. 根据 ALPN 优化连接策略
+  //    如果服务器支持 h3 (HTTP/3), 优先使用 QUIC
+  bool supports_h3 = false;
+  bool supports_h2 = false;
+  for (const auto& alpn : svcb_result.alpn) {
+    if (alpn == "h3") supports_h3 = true;
+    if (alpn == "h2") supports_h2 = true;
+  }
+
+  if (supports_h3) {
+    // 标记此请求支持 HTTP/3, 让 QUIC 连接池优先处理
+    context->SetSupportsHttp3(nik, true);
+  }
+
+  // 3. 应用 IP 地址提示
+  //    如果有 ipv4hint/ipv6hint, 跳过 A/AAAA 查询直接连接
+  if (!svcb_result.ipv4_hints.empty() || !svcb_result.ipv6_hints.empty()) {
+    IPAddressList hints;
+    hints.insert(hints.end(),
+                 svcb_result.ipv4_hints.begin(),
+                 svcb_result.ipv4_hints.end());
+    hints.insert(hints.end(),
+                 svcb_result.ipv6_hints.begin(),
+                 svcb_result.ipv6_hints.end());
+    context->SetAddressHints(nik, hints);
+  }
+
+  // 4. 应用端口提示
+  if (svcb_result.port.has_value()) {
+    context->SetAlternativePort(nik, svcb_result.port.value());
+  }
+}
+
+// HTTP -> HTTPS 升级 (SVCB 记录指示)
+//
+// 当 HTTPS 记录存在时，即使请求的是 http:// URL
+// 也应升级到 https:// (除非记录明确禁止)
+bool ShouldUpgradeHttpToHttps(const HttpsSvcbResult& result) {
+  if (!base::FeatureList::IsEnabled(features::kUseDnsHttpsSvcb))
+    return false;
+  if (!base::GetFieldTrialParamByFeatureAsBool(
+          features::kUseDnsHttpsSvcb, "HttpUpgrade", false))
+    return false;
+
+  // HTTPS 记录存在表示服务器支持 HTTPS
+  // 除非 AlpnMode 参数明确为 "none"
+  return !result.alpn.empty();
+}
+
+}  // namespace net
