+// =====================================================================
+// DNS over HTTPS (DoH) 配置增强
+// =====================================================================
+
+// DoH 服务器列表 - 按区域优化
+//
+// 当用户启用安全 DNS 时, Kiwi 将使用这些预置的 DoH 服务器
+// 用户也可以在 chrome://settings/security 中自定义
+std::vector<DohProviderEntry> GetKiwiDohProviders() {
+  std::vector<DohProviderEntry> providers;
+
+  // === 全球通用 (低延迟, 支持 ECH) ===
+
+  // 1. Cloudflare - 最快的 DoH 服务
+  //    支持: ECH, IPv6, DNSSEC
+  //    隐私: 不记录 IP, 24h 保留查询日志
+  providers.push_back(DohProviderEntry::Create(
+      "cloudflare",
+      "https://cloudflare-dns.com/dns-query",
+      true /* use_post */,
+      std::vector<std::string>{""} /* all domains */,
+      "2606:4700:4700::1111" /* ipv6 */));
+
+  // 2. Google Public DNS
+  //    支持: ECH, IPv6, DNSSEC
+  //    隐私: 匿名化数据, 24-48h 保留
+  providers.push_back(DohProviderEntry::Create(
+      "google",
+      "https://dns.google/dns-query",
+      true /* use_post */,
+      std::vector<std::string>{""} /* all domains */,
+      "2001:4860:4860::8888" /* ipv6 */));
+
+  // 3. Quad9 - 安全优先 (拦截恶意域名)
+  //    支持: ECH, IPv6, DNSSEC
+  //    隐私: 不记录 IP, GDPR 合规
+  providers.push_back(DohProviderEntry::Create(
+      "quad9",
+      "https://dns.quad9.net/dns-query",
+      true /* use_post */,
+      std::vector<std::string>{""} /* all domains */,
+      "2620:fe::fe" /* ipv6 */));
+
+  // === 中国地区优化 ===
+
+  // 4. 阿里云 DNS
+  //    国内低延迟, 支持 DNSSEC
+  providers.push_back(DohProviderEntry::Create(
+      "alidns",
+      "https://dns.alidns.com/dns-query",
+      true /* use_post */,
+      std::vector<std::string>{""} /* all domains */,
+      "2400:3200::1" /* ipv6 */));
+
+  return providers;
+}
+
+// =====================================================================
+// HTTPS / SVCB DNS 记录支持
+// =====================================================================
+
+// 启用 HTTPS SVCB 记录解析
+// 这些 DNS 记录提供:
+// - ECH 配置 (echconfig 参数)
+// - ALPN 协议协商 (alpn 参数)
+// - HTTP 到 HTTPS 升级 (port 参数)
+//
+// 配置 DnsConfig 使用 HTTPS 记录:
+void EnableHttpsSvcbInDnsConfig(DnsConfig* config) {
+  if (!base::FeatureList::IsEnabled(features::kUseDnsHttpsSvcb))
+    return;
+
+  config->use_dns_https_svcb = true;
+  config->use_dns_https_svcb_alpn =
+      base::FeatureList::IsEnabled(features::kUseDnsHttpsSvcbAlpn);
+  config->allow_dns_over_https = true;
+}
+
+}  // namespace net
--- a/net/dns/host_resolver_manager.cc
+++ b/net/dns/host_resolver_manager.cc
