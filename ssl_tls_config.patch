+// =====================================================================
+// TLS 1.3 Key Update - 定期更新会话密钥
+// RFC 8446 Section 4.4
+// =====================================================================
+
+// TLS 1.3 密钥更新定时器回调
+// 在长时间连接中定期更新通信密钥，限制单次密钥的加密数据量
+//
+// 配置建议：
+// - 密钥更新间隔: 每 100MB 数据或每 10 分钟更新一次
+// - 使用 post-handshake 认证更新
+class TLS13KeyUpdateController {
+ public:
+  static TLS13KeyUpdateController& GetInstance() {
+    static base::NoDestructor<TLS13KeyUpdateController> instance;
+    return *instance;
+  }
+
+  void ConfigureKeyUpdate(SSL* ssl) {
+    if (!base::FeatureList::IsEnabled(features::kTLS13KeyUpdate))
+      return;
+
+    // 启用 post-handshake 密钥更新
+    // 设置：每 100 条记录或 100MB 数据后触发更新
+    SSL_set_key_update_interval(ssl, 100);
+
+    DVLOG(1) << "TLS 1.3 Key Update configured";
+  }
+
+  // 触发密钥更新
+  static int MaybeTriggerKeyUpdate(SSL* ssl, int type, int value) {
+    if (type == SSL_CB_HANDSHAKE_DONE) {
+      // 握手完成后检查是否需要密钥更新
+      TLS13KeyUpdateController::GetInstance().ScheduleNextUpdate(ssl);
+    }
+    return 0;
+  }
+
+ private:
+  friend class base::NoDestructor<TLS13KeyUpdateController>;
+  TLS13KeyUpdateController() = default;
+  ~TLS13KeyUpdateController() = default;
+
+  void ScheduleNextUpdate(SSL* ssl) {
+    // 实际实现应绑定到网络事件循环
+    // 在收到足够的数据包后调用 SSL_key_update(ssl, 0)
+  }
+};
+
+// =====================================================================
+// TLS Extension Permutation - 随机化 ClientHello 扩展顺序
+// 防止服务器对特定扩展顺序产生依赖(ossification)
+// =====================================================================
+
+void ConfigureTLSExtensionPermutation(SSL_CTX* ctx) {
+  if (!base::FeatureList::IsEnabled(features::kPermuteTLSExtensions))
+    return;
+
+  // 启用 ClientHello 扩展排列
+  // BoringSSL 会随机化扩展顺序，避免服务器对特定顺序产生依赖
+  SSL_CTX_set_permute_extensions(ctx, 1);
+}
+
+// =====================================================================
+// Kyber 后量子密钥封装 (ML-KEM)
+// FIPS 203 (CRYSTALS-Kyber)
+// =====================================================================
+
+void ConfigurePostQuantumKeys(SSL_CTX* ctx) {
+  if (!base::FeatureList::IsEnabled(features::kPostQuantumCECPQ2))
+    return;
+
+  // 配置 Kyber 混合密钥协商
+  // 使用标准化的 Kyber768 + X25519 混合模式
+  //
+  // BoringSSL 中的曲线 ID:
+  // - NID_X25519_KYBER768: X25519 + Kyber768 混合
+  //
+  // 这会增加 ClientHello 约 1KB，但提供了抗量子安全性
+  const char* pq_groups[] = {
+    "X25519Kyber768Draft00",  // X25519 + Kyber768 混合 (标准草案)
+    "X25519",                 // 传统 ECDHE 作为后备
+  };
+
+  SSL_CTX_set1_groups_list(ctx, "X25519Kyber768Draft00:X25519");
+
+  DVLOG(1) << "Post-quantum Kyber key agreement configured";
+}
+
+// =====================================================================
+// SSL 配置入口 - 在 SSLClientSocket 初始化时调用
+// =====================================================================
+
+void ApplyKiwiNetworkProtocolConfig(SSL* ssl, SSL_CTX* ctx,
+                                     const SSLConfig& ssl_config) {
+  // 顺序: ECH -> TLS 1.3 Key Update -> TLS 扩展排列 -> 后量子加密
+
+  // 1. ECH (Encrypted ClientHello)
+  ConfigureECHForConnection(ssl, ssl_config);
+
+  // 2. TLS 1.3 Key Update (应用于 ssl 对象)
+  TLS13KeyUpdateController::GetInstance().ConfigureKeyUpdate(ssl);
+
+  // 3. TLS Extension Permutation (应用于 SSL_CTX)
+  ConfigureTLSExtensionPermutation(ctx);
+
+  // 4. Post-Quantum Kyber (应用于 SSL_CTX)
+  ConfigurePostQuantumKeys(ctx);
+
+  // 5. TLS 1.3 0-RTT Early Data
+  if (base::FeatureList::IsEnabled(features::kEnableTLS13EarlyData)) {
+    // 启用 0-RTT 早发数据
+    SSL_set_early_data_enabled(ssl, 1);
+
+    // 设置最大 0-RTT 数据量 (64KB)
+    SSL_set_max_early_data_size(ssl, 64 * 1024);
+  }
+}
