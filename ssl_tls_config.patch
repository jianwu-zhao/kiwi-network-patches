+// =====================================================================
+// Encrypted ClientHello (ECH) - 加密 SNI 防止中间人嗅探
+// RFC 8871, draft-ietf-tls-esni-13
+// =====================================================================
+
+// ECH 配置管理器：从 HTTPS DNS 记录或内置公钥加载 ECH 配置
+class ECHConfigManager {
+ public:
+  static ECHConfigManager& GetInstance() {
+    static base::NoDestructor<ECHConfigManager> instance;
+    return *instance;
+  }
+
+  // 为 SSL 连接配置 ECH
+  // 需要在 SSL_CTX 或 SSL 对象上设置以下参数：
+  //
+  // 1. SSL_set_ech_server_config_list(ssl, config_list)
+  //    - 从 HTTPS DNS SVCB 记录中获取 ECH 公钥配置
+  //    - 格式: echconfig=<base64> 参数
+  //
+  // 2. SSL_set_ech_grease_enabled(ssl, true)
+  //    - 发送 ECH GREASE 填充以探测服务器支持
+  //
+  // 3. SSL_set_ech_is_inner_call(ssl, callback)
+  //    - 确认当前连接是否为 ECH 内部连接
+  bool ConfigureECH(SSL* ssl, const std::string& ech_config_list) {
+    if (!base::FeatureList::IsEnabled(features::kEncryptedClientHello))
+      return false;
+
+    if (ech_config_list.empty())
+      return false;
+
+    // 解析 ECH 配置列表 (来自 HTTPS DNS 记录)
+    // 格式: 每个配置是二进制 blob, 多个配置串联
+    bssl::UniquePtr<SSL_ECH_KEYS> keys(SSL_ECH_KEYS_new());
+    if (!keys)
+      return false;
+
+    const uint8_t* data =
+        reinterpret_cast<const uint8_t*>(ech_config_list.data());
+    size_t len = ech_config_list.size();
+
+    if (!SSL_ECH_KEYS_add(keys.get(), /*is_retry_config=*/1, data, len)) {
+      return false;
+    }
+
+    SSL_set_ech_keys(ssl, keys.get());
+
+    DVLOG(1) << "ECH configured for connection";
+    return true;
+  }
+
+  // 配置 ECH GREASE - 即使没有 ECH 配置也发送兼容的扩展
+  // 用于探测路径是否支持 ECH，同时隐藏不使用 ECH 的用户
+  void EnableECHGrease(SSL* ssl) {
+    if (!base::FeatureList::IsEnabled(features::kEncryptedClientHello))
+      return;
+
+    // 发送 ECH GREASE 扩展 (类型 0xDD1E, 即 ECH 类型码)
+    // 内容为随机填充，使中间人无法区分真实 ECH 和 GREASE
+    SSL_set_ech_grease_enabled(ssl, 1);
+  }
+
+  // 设置 ECH 重试回调 - 当服务器返回 retry_config 时触发
+  static int ECHRetryCallback(SSL* ssl, int alert) {
+    // 服务器要求使用新的 ECH 配置重试
+    // 从 SSL_get_ech_retry_configs() 获取新配置
+    const uint8_t* retry_config;
+    size_t retry_config_len;
+    SSL_get_ech_retry_configs(ssl, &retry_config, &retry_config_len);
+
+    if (retry_config && retry_config_len > 0) {
+      DVLOG(1) << "ECH retry with new config (" << retry_config_len
+               << " bytes)";
+      // 解析并应用 retry_config
+      bssl::UniquePtr<SSL_ECH_KEYS> keys(SSL_ECH_KEYS_new());
+      if (keys && SSL_ECH_KEYS_add(keys.get(),
+                                    /*is_retry_config=*/1,
+                                    retry_config, retry_config_len)) {
+        SSL_set_ech_keys(ssl, keys.get());
+        return 1;  // 重试
+      }
+    }
+    return -1;  // 放弃 ECH，回退到明文 SNI
+  }
+
+ private:
+  friend class base::NoDestructor<ECHConfigManager>;
+  ECHConfigManager() = default;
+  ~ECHConfigManager() = default;
+};
+
+// 在 SSL 连接建立前配置 ECH
+// 此函数在 SSLClientSocket::Connect() 中调用
+void ConfigureECHForConnection(SSL* ssl, const SSLConfig& ssl_config) {
+  if (!base::FeatureList::IsEnabled(features::kEncryptedClientHello))
+    return;
+
+  auto& manager = ECHConfigManager::GetInstance();
+
+  // 1. 如果有 HTTPS DNS 记录中的 ECH 配置，使用它
+  if (!ssl_config.ech_config_list.empty()) {
+    manager.ConfigureECH(ssl, ssl_config.ech_config_list);
+  }
+
+  // 2. 始终启用 ECH GREASE
+  manager.EnableECHGrease(ssl);
+
+  // 3. 设置 ECH 重试回调
+  SSL_CTX_set_ech_retry_callback(
+      SSL_get_SSL_CTX(ssl),
+      ECHConfigManager::ECHRetryCallback);
+}
